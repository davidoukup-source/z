# Copie ce fichier en .env.local et remplis les valeurs. Ne commit JAMAIS .env.local.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
APP_URL=http://localhost:3000
ALLOWED_EMAIL=davidoukup@gmail.com
TIMEZONE=Europe/Brussels
BRIEF_TIME=08:30
# Emails complets ou domaines, séparés par des virgules
PRIORITY_SENDERS=@vub.be

# --- Google Cloud (OAuth client "Web application") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 octets en base64 : openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Resend ---
RESEND_API_KEY=
RESEND_FROM=Tableau de Vie <onboarding@resend.dev>

# --- Cron (chaîne aléatoire : openssl rand -hex 32) ---
CRON_SECRET=
